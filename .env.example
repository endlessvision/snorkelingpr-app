# --- Mobile (apps/mobile) ---
# Not required for the current build (fully local, no backend). Kept here
# for the later phase described in design-reference/06-backend.md.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000        # phone must reach your computer, not localhost
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- API (apps/api, added in a later phase) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only — never in the app
SUPABASE_JWT_SECRET=
STRIPE_SECRET_KEY=              # server only
STRIPE_WEBHOOK_SECRET=          # server only
FCM_SERVER_KEY=                 # server only
